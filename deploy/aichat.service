# AIChat（QQ 群 AI 机器人）的 systemd 单元。
#
# 部署形态：
#   代码检出  /opt/aichat/app       ← chat 分支，由 aichat-update 快进
#   可写数据  /var/lib/aichat/data  ← QQ_AGENT_DATA_DIR（config/sessions/messages/memory 全在这）
#   控制台    127.0.0.1:3210        ← 只回环，经 SSH 隧道访问
#
# 代码与数据分离是热更新的前提：换代码只动 /opt/aichat/app，数据一个字节都不碰。
#
# ★ 启动顺序：NapCat 是 **__DEPLOY_USER__ 的用户级 unit**，本服务是系统单元，
#   跨 manager 写不了依赖（After= 只在本 manager 内生效）。所以不声明依赖：
#   启动前只做一次**有界**的 OneBot 预热探测，探到就继续、超时也继续（见 ExecStartPre）。
[Unit]
Description=AIChat QQ 群 AI 机器人（headless）
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__DEPLOY_USER__
WorkingDirectory=/opt/aichat/app
Environment=QQ_AGENT_DATA_DIR=/var/lib/aichat/data
Environment=QQ_AGENT_PORT=3210
Environment=NODE_ENV=production
# 时区：进程里所有「给人看 / 给模型看」的时间都走本地时区（src/util.js）。
# 宿主默认 UTC，不指定就整体慢 8 小时 —— 注入提示词的【当前时间】、消息时间戳、
# 日志时间、峰谷时段、提醒解析、按日分桶统统受影响。这里固定北京时间。
Environment=TZ=Asia/Shanghai
# 启动前有界探测 OneBot HTTP（最多约 5 秒），**任何情况都不许阻塞启动**（2026-10-20）：
#   3002 只在 QQ 登录成功后才监听。QQ 登出态（未扫码）时这里若阻塞或失败，
#   Restart=always 会无限重试 ⇒ 3210 永不监听 ⇒ 控制台打不开 ⇒ 用户连「扫码登录」
#   的网页都进不去（自锁）。所以探到就继续，超时打印 WARN 也 exit 0。
#   迟到的 OneBot 由代码侧自愈：src/app.js 每 2 秒探一次 OneBot 端口、端口一开立即重连，
#   src/onebot.js 的连接循环无限退避重试 —— 不需要在这里把进程挡在门外等它。
ExecStartPre=/bin/bash -c 'for i in $(seq 1 5); do curl -sf -m 2 -o /dev/null http://127.0.0.1:3002/get_login_info && exit 0; sleep 1; done; echo "WARN: OneBot 未就绪，先起控制台（QQ 登录后会自动连上）" >&2; exit 0'
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5
# QQ 消息不会丢：未读消息留在 data/messages/*.json，起来后自己补处理。

[Install]
WantedBy=multi-user.target
